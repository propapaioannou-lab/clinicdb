# Copy this file to .env and fill in real values. Never commit .env.

# Database
POSTGRES_DB=clinicdb
POSTGRES_USER=clinicdb
# Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=change-me

# Session cookie is "Secure" (HTTPS only; http://localhost also works). Leave unset.
# COOKIE_SECURE=false

# Encrypts 2FA secrets. Generate once with: openssl rand -hex 32
# Never change or lose it: stored 2FA setups would become unreadable.
APP_SECRET=change-me-64-hex-characters
