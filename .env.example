# Copy this file to .env and fill in real values. Never commit .env.

# Database
POSTGRES_DB=clinicdb
POSTGRES_USER=clinicdb
# Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=change-me

# Session cookie is "Secure" (HTTPS only; http://localhost also works). Leave unset.
# COOKIE_SECURE=false

# Encrypts 2FA secrets. Generate once with: openssl rand -hex 32
# Never change or lose it: stored 2FA setups would become unreadable.
APP_SECRET=change-me-64-hex-characters

# Address people use to reach the app (used in invitation links).
APP_URL=http://localhost:3000

# Email. On the laptop compose points this at the local test mailbox (http://localhost:8025).
# On the Synology: the email provider's SMTP settings (provider must sign a DPA).
SMTP_FROM="Αρχείο Ασθενών <no-reply@example.com>"
# SMTP_HOST=smtp.example.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=
# SMTP_PASS=
