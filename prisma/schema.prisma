generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// What a user may do (SPEC §11). Company access is separate (Membership).
enum Level {
  OWNER
  ADMIN
  USER
  GUEST
}

// What someone does at the practice; separate from Level (what they may do).
enum Role {
  SURGEON
  PA_NURSE
  SECRETARY
  SPA_STAFF
  OTHER
}

// A legal/business unit that owns records: "surgery" or "spa".
model Company {
  id               String            @id @default(cuid())
  code             String            @unique
  name             String
  createdAt        DateTime          @default(now())
  memberships      Membership[]
  patients         Patient[]
  listItems        ListItem[]
  historyQuestions HistoryQuestion[]
}

model User {
  id              String          @id @default(cuid())
  email           String          @unique // stored lower-case
  name            String
  // Empty until an invited user chooses a password.
  passwordHash    String?
  level           Level           @default(USER)
  isActive        Boolean         @default(true)
  // Required for Guests: access stops after this moment.
  accessExpiresAt DateTime?
  // Lockout after repeated wrong passwords.
  failedLogins    Int             @default(0)
  lockedUntil     DateTime?
  lastLoginAt     DateTime?
  // 2FA: secret encrypted with APP_SECRET; enabled once the first code is confirmed.
  totpSecretEnc   String?
  totpEnabledAt   DateTime?
  // Last accepted 30 s step, so a code can never be used twice.
  totpLastStep    Int?
  // Job (SPEC §11): decides the home screen, who verifies history, who is treating doctor.
  role            Role            @default(OTHER)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  memberships     Membership[]
  sessions        Session[]
  recoveryCodes   RecoveryCode[]
  trustedDevices  TrustedDevice[]
  invitations     Invitation[]
  doctorOf        Patient[]       @relation("TreatingDoctor")
}

// Which companies a user can see and work in.
model Membership {
  userId    String
  companyId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@id([userId, companyId])
  @@index([companyId])
}

// PENDING_*: password was right, 2FA still to do (short-lived, reaches only the 2FA pages).
enum SessionStage {
  PENDING_2FA
  PENDING_ENROLL
  ACTIVE
}

// One logged-in browser/device. The cookie holds a random token; only its hash is stored.
model Session {
  id               String       @id @default(cuid())
  tokenHash        String       @unique
  userId           String
  createdAt        DateTime     @default(now())
  lastSeenAt       DateTime     @default(now())
  // Next Monday 05:00 Athens time (SPEC §11).
  expiresAt        DateTime
  ip               String?
  userAgent        String?
  revokedAt        DateTime?
  revokedById      String?
  // "logout", "admin", ...
  revokeReason     String?
  stage            SessionStage @default(ACTIVE)
  // Set when the login skipped 2FA because of a trusted device.
  trustedDeviceId  String?
  // New recovery codes, encrypted, kept only until shown once right after 2FA setup.
  recoveryCodesEnc String?
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
}

// Append-only record of who did what (CLAUDE.md). A database trigger refuses any
// UPDATE, DELETE or TRUNCATE (migration audit_log_immutable). No foreign keys, so entries
// survive even if the user or record they mention is later deleted.
model AuditLog {
  id          BigInt   @id @default(autoincrement())
  at          DateTime @default(now())
  actorUserId String?
  actorEmail  String?
  companyId   String?
  // e.g. "auth.login.success", "patient.view"
  action      String
  entityType  String?
  entityId    String?
  ip          String?
  userAgent   String?
  details     Json?

  @@index([at])
  @@index([actorUserId, at])
  @@index([entityType, entityId, at])
  @@index([entityId, at])
  @@index([action, at])
}

// One-time codes for when the phone is lost. Only keyed fingerprints are stored.
model RecoveryCode {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String    @unique
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// A browser where the user ticked "Trust this device": no 2FA code for 90 days.
model TrustedDevice {
  id          String    @id @default(cuid())
  userId      String
  tokenHash   String    @unique
  createdAt   DateTime  @default(now())
  lastUsedAt  DateTime?
  expiresAt   DateTime
  ip          String?
  userAgent   String?
  revokedAt   DateTime?
  revokedById String?
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
}

// Email link to set up an account: single use, 72 hours. Only the token's hash is stored.
model Invitation {
  id          String    @id @default(cuid())
  userId      String
  tokenHash   String    @unique
  createdById String
  createdAt   DateTime  @default(now())
  expiresAt   DateTime
  usedAt      DateTime?
  // Replaced by a newer link, or cancelled.
  revokedAt   DateTime?
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Record kept after a user is permanently deleted, so their audit history stays readable.
model DeletedUser {
  id             String   @id @default(cuid())
  // The deleted user's id, as it appears in the audit log.
  userId         String   @unique
  email          String
  name           String
  level          Level
  companies      String[]
  createdAt      DateTime
  deletedAt      DateTime @default(now())
  deletedById    String
  deletedByEmail String

  @@index([deletedAt])
  @@index([email])
}

// One nightly (or manual) backup run, written by the backup container.
model BackupRun {
  id         String    @id @default(cuid())
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  // "running", "ok", "failed"
  status     String
  fileName   String?
  sizeBytes  BigInt?
  // The copy was restored into a scratch database and checked.
  verified   Boolean   @default(false)
  details    Json?

  @@index([startedAt])
}

// Editable lists (settings), separate for each company.
enum ListKind {
  MARITAL_STATUS
  REFERRAL_SOURCE
  TAX_OFFICE
  FLAG_REASON
  VISIT_TYPE
  CONDITION
}

model ListItem {
  id        String   @id @default(cuid())
  companyId String
  kind      ListKind
  label     String
  sortOrder Int      @default(0)
  // Hidden from new choices; records that already use it keep it.
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)

  maritalOf     Patient[]           @relation("MaritalStatus")
  referralOf    Patient[]           @relation("ReferralSource")
  taxOfficeOf   Patient[]           @relation("TaxOffice")
  flagReasonsOf PatientFlagReason[]

  @@unique([companyId, kind, label])
  @@index([companyId, kind, sortOrder])
}

enum Sex {
  FEMALE
  MALE
  OTHER
}

// Language of every form, consent and message for this patient (SPEC §4).
enum ContactLanguage {
  EL
  EN
}

enum PatientFlag {
  NONE
  YELLOW
  RED
}

enum PhoneType {
  MOBILE
  HOME
  WORK
  OTHER
}

// SPEC §4 "Basic info". Belongs to one company; every query filters by companyId.
model Patient {
  id                 String          @id @default(cuid())
  companyId          String
  // Unique within the company. Imported patients keep their my-medical number.
  number             Int
  surname            String
  firstName          String          @default("")
  fatherName         String?
  // Name in a simplified Latin form (no accents; Greek and Greeklish alike), for search.
  searchName         String
  // Capitals without accents, for alphabetical order.
  sortName           String
  birthDate          DateTime?       @db.Date
  sex                Sex?
  maritalStatusId    String?
  occupation         String?
  referralSourceId   String?
  referralNote       String?
  registeredAt       DateTime        @default(now())
  language           ContactLanguage @default(EL)
  area               String?
  address            String?
  city               String?
  postcode           String?
  country            String?
  amka               String?
  afm                String?
  taxOfficeId        String?
  // my-medical keeps these apart for e-prescription.
  eprescriptionCity  String?
  eprescriptionPhone String?
  // Until the consent system (SPEC §7) takes over.
  marketingConsent   Boolean         @default(false)
  // Shown as an alert on the patient header.
  infectiousDiseases String?
  treatingDoctorId   String?
  comments           String?
  // Staff-only marker; never sent to GHL or shown to the patient.
  flag               PatientFlag     @default(NONE)
  flagNote           String?
  flagSetAt          DateTime?
  flagSetById        String?
  ghlContactId       String?
  // Archived = hidden from search and lists, everything kept (never deleted in the app).
  archivedAt         DateTime?
  archivedById       String?
  createdAt          DateTime        @default(now())
  createdById        String?
  updatedAt          DateTime        @updatedAt

  company         Company                 @relation(fields: [companyId], references: [id], onDelete: Restrict)
  maritalStatus   ListItem?               @relation("MaritalStatus", fields: [maritalStatusId], references: [id], onDelete: SetNull)
  referralSource  ListItem?               @relation("ReferralSource", fields: [referralSourceId], references: [id], onDelete: SetNull)
  taxOffice       ListItem?               @relation("TaxOffice", fields: [taxOfficeId], references: [id], onDelete: SetNull)
  treatingDoctor  User?                   @relation("TreatingDoctor", fields: [treatingDoctorId], references: [id], onDelete: SetNull)
  phones          PatientPhone[]
  emails          PatientEmail[]
  flagReasons     PatientFlagReason[]
  notDupA         PatientNotDuplicate[]   @relation("NotDupA")
  notDupB         PatientNotDuplicate[]   @relation("NotDupB")
  history         PatientHistory?
  historyVersions PatientHistoryVersion[]

  @@unique([companyId, number])
  @@index([companyId, sortName])
  @@index([companyId, amka])
  @@index([searchName(ops: raw("gin_trgm_ops"))], type: Gin)
}

model PatientPhone {
  id        String    @id @default(cuid())
  companyId String
  patientId String
  // As typed, e.g. "+30 694 123 4567".
  number    String
  // Digits only, without +30/0030, for search and duplicate checks.
  digits    String
  type      PhoneType @default(MOBILE)
  // Main number, also used for WhatsApp.
  isMain    Boolean   @default(false)
  sortOrder Int       @default(0)
  patient   Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@index([companyId, digits])
  @@index([digits(ops: raw("gin_trgm_ops"))], type: Gin)
}

model PatientEmail {
  id        String  @id @default(cuid())
  companyId String
  patientId String
  // Stored lower-case.
  email     String
  sortOrder Int     @default(0)
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@index([companyId, email])
  @@index([email(ops: raw("gin_trgm_ops"))], type: Gin)
}

model PatientFlagReason {
  patientId  String
  listItemId String
  companyId  String
  patient    Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  listItem   ListItem @relation(fields: [listItemId], references: [id], onDelete: Restrict)

  @@id([patientId, listItemId])
  @@index([listItemId])
}

// Staff said "not the same person" for this pair, so the duplicate warning does not
// repeat (SPEC §6b). Stored once per pair, smaller id first.
model PatientNotDuplicate {
  companyId   String
  patientAId  String
  patientBId  String
  createdAt   DateTime @default(now())
  createdById String?
  patientA    Patient  @relation("NotDupA", fields: [patientAId], references: [id], onDelete: Cascade)
  patientB    Patient  @relation("NotDupB", fields: [patientBId], references: [id], onDelete: Cascade)

  @@id([patientAId, patientBId])
  @@index([patientBId])
}

// One question of the medical-history questionnaire (SPEC §4): Yes/No + details when Yes.
// Editable in Settings, so new questions need no code change.
model HistoryQuestion {
  id        String   @id @default(cuid())
  companyId String
  // Stable name used in stored answers, e.g. "hyper", "hepc".
  key       String
  // Section key, e.g. "heart", "infections" (titles in the translation files).
  section   String
  labelEl   String
  labelEn   String
  detailEl  String?
  detailEn  String?
  hintEl    String?
  hintEn    String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  // Hidden from Guests (e.g. substance use).
  sensitive Boolean  @default(false)
  // A verified Yes fills the infectious-disease alert on the patient header.
  infection Boolean  @default(false)
  createdAt DateTime @default(now())
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([companyId, key])
  @@index([companyId, section, sortOrder])
}

enum HistoryStatus {
  PENDING
  VERIFIED
}

enum HistorySource {
  STAFF
  PATIENT
  IMPORT
}

// Where a patient's history stands: which version is current and whether a physician
// or PA/nurse has verified it (SPEC §4 "Verification").
model PatientHistory {
  patientId        String                @id
  companyId        String
  currentVersionId String                @unique
  status           HistoryStatus         @default(PENDING)
  verifiedAt       DateTime?
  verifiedById     String?
  verifiedByName   String?
  verifiedRole     Role?
  updatedAt        DateTime              @updatedAt
  patient          Patient               @relation(fields: [patientId], references: [id], onDelete: Cascade)
  currentVersion   PatientHistoryVersion @relation("CurrentHistory", fields: [currentVersionId], references: [id], onDelete: Restrict)

  @@index([companyId, status])
}

// Every saved state of the answers is kept; nothing is overwritten. The patient's own
// answers stay readable after staff corrections.
model PatientHistoryVersion {
  id            String          @id @default(cuid())
  patientId     String
  companyId     String
  number        Int
  source        HistorySource
  createdById   String?
  createdByName String?
  createdAt     DateTime        @default(now())
  data          Json
  patient       Patient         @relation(fields: [patientId], references: [id], onDelete: Cascade)
  currentOf     PatientHistory? @relation("CurrentHistory")

  @@unique([patientId, number])
  @@index([companyId])
}
