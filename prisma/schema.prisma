generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// What a user may do (SPEC §11). Company access is separate (Membership).
enum Level {
  OWNER
  ADMIN
  USER
  GUEST
}

// A legal/business unit that owns records: "surgery" or "spa".
model Company {
  id          String       @id @default(cuid())
  code        String       @unique
  name        String
  createdAt   DateTime     @default(now())
  memberships Membership[]
}

model User {
  id              String          @id @default(cuid())
  email           String          @unique // stored lower-case
  name            String
  // Empty until an invited user chooses a password.
  passwordHash    String?
  level           Level           @default(USER)
  isActive        Boolean         @default(true)
  // Required for Guests: access stops after this moment.
  accessExpiresAt DateTime?
  // Lockout after repeated wrong passwords.
  failedLogins    Int             @default(0)
  lockedUntil     DateTime?
  lastLoginAt     DateTime?
  // 2FA: secret encrypted with APP_SECRET; enabled once the first code is confirmed.
  totpSecretEnc   String?
  totpEnabledAt   DateTime?
  // Last accepted 30 s step, so a code can never be used twice.
  totpLastStep    Int?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  memberships     Membership[]
  sessions        Session[]
  recoveryCodes   RecoveryCode[]
  trustedDevices  TrustedDevice[]
  invitations     Invitation[]
}

// Which companies a user can see and work in.
model Membership {
  userId    String
  companyId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@id([userId, companyId])
  @@index([companyId])
}

// PENDING_*: password was right, 2FA still to do (short-lived, reaches only the 2FA pages).
enum SessionStage {
  PENDING_2FA
  PENDING_ENROLL
  ACTIVE
}

// One logged-in browser/device. The cookie holds a random token; only its hash is stored.
model Session {
  id               String       @id @default(cuid())
  tokenHash        String       @unique
  userId           String
  createdAt        DateTime     @default(now())
  lastSeenAt       DateTime     @default(now())
  // Next Monday 05:00 Athens time (SPEC §11).
  expiresAt        DateTime
  ip               String?
  userAgent        String?
  revokedAt        DateTime?
  revokedById      String?
  // "logout", "admin", ...
  revokeReason     String?
  stage            SessionStage @default(ACTIVE)
  // Set when the login skipped 2FA because of a trusted device.
  trustedDeviceId  String?
  // New recovery codes, encrypted, kept only until shown once right after 2FA setup.
  recoveryCodesEnc String?
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
}

// Append-only record of who did what (CLAUDE.md). No foreign keys, so entries
// survive even if the user or record they mention is later deleted.
model AuditLog {
  id          BigInt   @id @default(autoincrement())
  at          DateTime @default(now())
  actorUserId String?
  actorEmail  String?
  companyId   String?
  // e.g. "auth.login.success", "patient.view"
  action      String
  entityType  String?
  entityId    String?
  ip          String?
  userAgent   String?
  details     Json?

  @@index([at])
  @@index([actorUserId, at])
  @@index([entityType, entityId, at])
  @@index([action, at])
}

// One-time codes for when the phone is lost. Only keyed fingerprints are stored.
model RecoveryCode {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String    @unique
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// A browser where the user ticked "Trust this device": no 2FA code for 90 days.
model TrustedDevice {
  id          String    @id @default(cuid())
  userId      String
  tokenHash   String    @unique
  createdAt   DateTime  @default(now())
  lastUsedAt  DateTime?
  expiresAt   DateTime
  ip          String?
  userAgent   String?
  revokedAt   DateTime?
  revokedById String?
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
}

// Email link to set up an account: single use, 72 hours. Only the token's hash is stored.
model Invitation {
  id          String    @id @default(cuid())
  userId      String
  tokenHash   String    @unique
  createdById String
  createdAt   DateTime  @default(now())
  expiresAt   DateTime
  usedAt      DateTime?
  // Replaced by a newer link, or cancelled.
  revokedAt   DateTime?
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Record kept after a user is permanently deleted, so their audit history stays readable.
model DeletedUser {
  id             String   @id @default(cuid())
  // The deleted user's id, as it appears in the audit log.
  userId         String   @unique
  email          String
  name           String
  level          Level
  companies      String[]
  createdAt      DateTime
  deletedAt      DateTime @default(now())
  deletedById    String
  deletedByEmail String

  @@index([deletedAt])
  @@index([email])
}
