generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// What a user may do (SPEC §11). Company access is separate (Membership).
enum Level {
  OWNER
  ADMIN
  USER
  GUEST
}

// A legal/business unit that owns records: "surgery" or "spa".
model Company {
  id          String       @id @default(cuid())
  code        String       @unique
  name        String
  createdAt   DateTime     @default(now())
  memberships Membership[]
}

model User {
  id              String       @id @default(cuid())
  email           String       @unique // stored lower-case
  name            String
  passwordHash    String
  level           Level        @default(USER)
  isActive        Boolean      @default(true)
  // Required for Guests: access stops after this moment.
  accessExpiresAt DateTime?
  // Lockout after repeated wrong passwords.
  failedLogins    Int          @default(0)
  lockedUntil     DateTime?
  lastLoginAt     DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  memberships     Membership[]
  sessions        Session[]
}

// Which companies a user can see and work in.
model Membership {
  userId    String
  companyId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@id([userId, companyId])
  @@index([companyId])
}

// One logged-in browser/device. The cookie holds a random token; only its hash is stored.
model Session {
  id           String    @id @default(cuid())
  tokenHash    String    @unique
  userId       String
  createdAt    DateTime  @default(now())
  lastSeenAt   DateTime  @default(now())
  // Next Monday 05:00 Athens time (SPEC §11).
  expiresAt    DateTime
  ip           String?
  userAgent    String?
  revokedAt    DateTime?
  revokedById  String?
  // "logout", "admin", ...
  revokeReason String?
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
}

// Append-only record of who did what (CLAUDE.md). No foreign keys, so entries
// survive even if the user or record they mention is later deleted.
model AuditLog {
  id          BigInt   @id @default(autoincrement())
  at          DateTime @default(now())
  actorUserId String?
  actorEmail  String?
  companyId   String?
  // e.g. "auth.login.success", "patient.view"
  action      String
  entityType  String?
  entityId    String?
  ip          String?
  userAgent   String?
  details     Json?

  @@index([at])
  @@index([actorUserId, at])
  @@index([entityType, entityId, at])
  @@index([action, at])
}
