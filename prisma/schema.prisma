generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// What a user may do (SPEC §11). Company access is separate (Membership).
enum Level {
  OWNER
  ADMIN
  USER
  GUEST
}

// A legal/business unit that owns records: "surgery" or "spa".
model Company {
  id          String       @id @default(cuid())
  code        String       @unique
  name        String
  createdAt   DateTime     @default(now())
  memberships Membership[]
}

model User {
  id              String       @id @default(cuid())
  email           String       @unique // stored lower-case
  name            String
  passwordHash    String
  level           Level        @default(USER)
  isActive        Boolean      @default(true)
  // Required for Guests: access stops after this moment.
  accessExpiresAt DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  memberships     Membership[]
}

// Which companies a user can see and work in.
model Membership {
  userId    String
  companyId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@id([userId, companyId])
  @@index([companyId])
}
